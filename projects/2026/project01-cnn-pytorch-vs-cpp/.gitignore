# Build artefacts
build/*
!build/*.s

# Object files
*.o

# Python bytecode cache
__pycache__/
*.pyc

# OS cruft and editor swap files
.DS_Store
*.swp
*~

# Generated by cnn_forward / benchmark.py — regenerated on every run.
src/python/weights_cpp/cpp_timing_batch*.json
src/python/weights_cpp/cpp_verify_manifest.json
src/python/weights_cpp/cpp_logits*.bin

# MNIST dataset — downloaded into data/ on first use, never committed.
/data/**
!/data/.gitkeep
